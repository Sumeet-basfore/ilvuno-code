# Git 2.38.1 built from source on Alpine: the declared floor for Ilvuno (ADR-0004).
# Provenance:
#   base image   alpine:3.17@sha256:8fc3dacfb6d69da8d44e42390de777e48577085db99aa4e4af35f483eb08b989
#   git source   https://www.kernel.org/pub/software/scm/git/git-2.38.1.tar.xz
#   sha256       97ddf8ea58a2b9e0fbc2508e245028ca75911bd38d1551616b148c1aa5740ad9
# The checksum is pinned from the build that produced the recorded results. It was not
# verified against an upstream signature; see docs/experiments/sp1r-reproducibility.md.
FROM alpine:3.17@sha256:8fc3dacfb6d69da8d44e42390de777e48577085db99aa4e4af35f483eb08b989
ARG GIT_URL=https://www.kernel.org/pub/software/scm/git/git-2.38.1.tar.xz
ARG GIT_SHA256=97ddf8ea58a2b9e0fbc2508e245028ca75911bd38d1551616b148c1aa5740ad9
RUN apk add --no-cache bash coreutils findutils curl python3 build-base openssl-dev curl-dev \
      expat-dev zlib-dev perl linux-headers ca-certificates >/dev/null \
 && curl -sSLo /tmp/git.tar.xz "$GIT_URL" \
 && echo "$GIT_SHA256  /tmp/git.tar.xz" | sha256sum -c - \
 && tar xf /tmp/git.tar.xz -C /tmp \
 && make -C /tmp/git-2.38.1 -j"$(nproc)" NO_TCLTK=1 NO_GETTEXT=1 NO_DOCS=1 NO_PERL=1 NO_PYTHON=1 NO_REGEX=YesPlease prefix=/usr/local >/dev/null 2>&1 \
 && make -C /tmp/git-2.38.1 NO_TCLTK=1 NO_GETTEXT=1 NO_DOCS=1 NO_PERL=1 NO_PYTHON=1 NO_REGEX=YesPlease prefix=/usr/local install >/dev/null 2>&1 \
 && rm -rf /tmp/git-2.38.1 /tmp/git.tar.xz
CMD ["git","--version"]
