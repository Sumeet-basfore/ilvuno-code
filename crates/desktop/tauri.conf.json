{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ilvuno",
  "version": "0.0.1",
  "identifier": "dev.ilvuno.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "Ilvuno",
        "width": 1060,
        "height": 900,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' http://127.0.0.1:4737; img-src 'self' data:; base-uri 'none'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png"]
  }
}
